# Copia a tu entorno local. Nunca commitees valores reales.
ANTHROPIC_API_KEY=
# Opcional: carpeta de datos locales (token de Google, pendientes). Por defecto ~/.ajel_secretaria
SECRETARIA_DATOS=
# Opcional: ruta del JSON de OAuth de Google (por defecto ~/.ajel_secretaria/credentials.json)
SECRETARIA_GOOGLE_CREDENCIALES=
