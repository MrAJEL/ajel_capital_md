# AJEL Capital — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database credentials
POSTGRES_USER=ajeluser
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=ajelcapital

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_HERE

# FMP API Key (optional — enables enhanced fundamentals)
# Get one free at: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Environment mode: development or production
ENVIRONMENT=production

# CORS origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
